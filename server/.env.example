# Local defaults. On Render, set these in the dashboard. Do not commit server/.env.
# file = JSON store in server/data. Render's disk is wiped on deploy, so production uses mongo.
# mongo = MongoDB. Locally: docker compose up -d
NODE_ENV=development
DB_DRIVER=file
MONGODB_URI=mongodb://127.0.0.1:27017/game-thu-gian

# Render sets PORT itself. This value is only for local runs.
PORT=4000
# Replace this before any shared or production deployment.
JWT_SECRET=dev-only-change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated browser origins. Use * only for local development and Expo Go.
CORS_ORIGIN=*
