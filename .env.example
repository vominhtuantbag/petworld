# Public client settings. Expo inlines EXPO_PUBLIC_* at build time.
# Production export uses .env.production, which points at Render.
# Copy this file to .env.local to call a server on your machine instead.
EXPO_PUBLIC_API_URL=https://petworld-rqyo.onrender.com
EXPO_PUBLIC_SOCKET_URL=https://petworld-rqyo.onrender.com
